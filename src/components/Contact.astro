---
import "../styles/components/contact.css";
import Marks from "./Marks.astro";
import { contact, images } from "../data/content";

const rows = [
  {
    label: "Email",
    value: contact.email,
    href: contact.email ? `mailto:${contact.email}` : null,
    empty: "Add your email",
  },
  {
    label: "GitHub",
    value: contact.github,
    href: contact.github,
    empty: "Add GitHub URL",
  },
  {
    label: "LinkedIn",
    value: contact.linkedin,
    href: contact.linkedin,
    empty: "Add LinkedIn URL",
  },
];

const external = (href: string) => /^https?:\/\//.test(href);
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="contact-media">
    <img
      src={images.contact.src}
      alt={images.contact.alt}
      width={images.contact.width}
      height={images.contact.height}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="contact-inner">
    <p class="kicker">07 — Close</p>
    <h2 id="contact-title" class="display" data-reveal>
      <span>{contact.headingLead}</span>
      <span>{contact.headingTail}</span>
    </h2>
    <div class="contact-tools" data-parallax="12">
      <Marks name="star" />
      <Marks name="cross" />
      <p class="hand contact-note">write it down, then send it</p>
    </div>
    <ul class="contact-list">
      {
        rows.map((row) => (
          <li data-reveal>
            {row.href ? (
              <a
                class="contact-row"
                href={row.href}
                {...(external(row.href) ? { target: "_blank", rel: "noreferrer noopener" } : {})}
              >
                <strong>{row.label}</strong>
                <em>{row.value}</em>
              </a>
            ) : (
              <p class="contact-row">
                <strong>{row.label}</strong>
                <em class="is-placeholder">{row.empty}</em>
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
