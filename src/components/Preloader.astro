---
import "../styles/components/preloader.css";
---

<div id="preloader" role="status" aria-live="polite" aria-label="Loading portfolio">
  <div class="preloader-inner">
    <p class="preloader-kicker">Issue 01 — boot</p>
    <span id="preloader-wordmark" class="wordmark-mark preloader-mark" aria-hidden="true">HT</span>
    <div class="preloader-bar" aria-hidden="true">
      <span class="preloader-bar-fill"></span>
    </div>
    <p class="preloader-progress" id="preloader-progress" aria-hidden="true">0%</p>
  </div>
</div>
